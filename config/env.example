# 复制为 .env 后按需修改；所有值均为占位符，不要提交真实凭证。
# 加载方式：  . ./config/env.example   （或 set -a; . ./.env; set +a）

# 二进制与 CLI 路径（容器里常是静态二进制，没有包管理器）
TAILSCALE_BIN=tailscaled
TAILSCALE_CLI=tailscale

# 状态与控制 socket —— 必须落盘，进程被回收后无需重新登录
TAILSCALE_STATE=/var/lib/tailscale/tailscaled.state
TAILSCALE_SOCKET=/run/tailscale/tailscaled.sock

# SOCKS5 只绑回环地址
TAILSCALE_SOCKS=127.0.0.1:1055
TAILSCALE_LOG=/tmp/tailscaled.log

# 一次性、短期、带 tag 的 authkey：用环境变量临时传入，绝不写进文件
# export TS_AUTHKEY=tskey-REPLACE_ME
# tailscale up --authkey="$TS_AUTHKEY"

# 健康检查可选：经代理访问的目标（用于判断链路，非认证）
HEALTHCHECK_URL=https://example.com

# 目标节点示例（占位符）
# TARGET_HOST=100.x.y.z
# TARGET_SSH_PORT=2222
